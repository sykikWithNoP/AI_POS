{
  "name": "free-ai-pos",
  "version": "1.2.0",
  "description": "Advanced self-hosted POS with BYOK integrations: payments, IRD CBMS, Google Calendar, AI copilot and user-built extensions.",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node scripts/launcher.mjs",
    "dev": "node --no-warnings=ExperimentalWarning --watch server/index.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js",
    "seal": "node scripts/seal.js",
    "build": "node scripts/build.js",
    "reset-owner": "node --no-warnings=ExperimentalWarning server/index.js --reset-owner",
    "server": "node --no-warnings=ExperimentalWarning server/index.js",
    "keygen": "node scripts/keygen.js",
    "vendor": "node scripts/vendor.js",
    "setup": "node -e \"console.log('Use ./install.sh (macOS/Linux) or install.bat (Windows)')\"",
    "package": "node packaging/package.mjs",
    "icons": "node packaging/make-icons.cjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "express": "^5.3.0",
    "nepali-date-converter": "^3.4.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "private": true
}
