{
  "name": "nindito-pos-mobile",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "NINDITO POS for Android and iPhone: the full POS running inside the phone. Updates come from GitHub Releases.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "sync": "npm run build && npx cap sync",
