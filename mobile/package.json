    "test": "node --test test/shims.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/app": "7.1.2",
    "@capacitor/browser": "7.0.5",
    "@capacitor/core": "7.6.10",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/ios": "7.6.10",
    "@capacitor/share": "7.0.4",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "buffer": "^6.0.3",
    "fflate": "0.7.5",
    "sql.js": "1.15.2"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "esbuild": "0.28.2"
  }
}
